using System;
using System.Drawing;
using System.Text;

public static class SteganographyHelper
{
    public static Bitmap EncodeText(string text, Bitmap bmp)
    {
        int textIndex = 0;
        int charValue = 0;
        long pixelElementIndex = 0;
        int zeros = 0;
        bool isTextEnded = false;

        for (int i = 0; i < bmp.Height; i++)
        {
            for (int j = 0; j < bmp.Width; j++)
            {
                Color pixel = bmp.GetPixel(j, i);
                int R = pixel.R - pixel.R % 2;
                int G = pixel.G - pixel.G % 2;
                int B = pixel.B - pixel.B % 2;

                for (int n = 0; n < 3; n++)
                {
                    if (pixelElementIndex % 8 == 0)
                    {
                        if (isTextEnded && zeros == 8)
                        {
                            bmp.SetPixel(j, i, Color.FromArgb(R, G, B));
                            return bmp;
                        }

                        if (textIndex >= text.Length)
                        {
                            isTextEnded = true;
                        }
                        else
                        {
                            charValue = text[textIndex++];
                        }
                    }

                    switch (pixelElementIndex % 3)
                    {
                        case 0:
                            R += (charValue % 2);
                            charValue /= 2;
                            break;
                        case 1:
                            G += (charValue % 2);
                            charValue /= 2;
                            break;
                        case 2:
                            B += (charValue % 2);
                            charValue /= 2;
                            break;
                    }

                    pixelElementIndex++;

                    if (isTextEnded)
                        zeros++;
                }

                bmp.SetPixel(j, i, Color.FromArgb(R, G, B));
            }
        }
        return bmp;
    }

    public static string DecodeText(Bitmap bmp)
    {
        int colorUnitIndex = 0;
        int charValue = 0;
        string extractedText = "";

        for (int i = 0; i < bmp.Height; i++)
        {
            for (int j = 0; j < bmp.Width; j++)
            {
                Color pixel = bmp.GetPixel(j, i);
                for (int n = 0; n < 3; n++)
                {
                    switch (colorUnitIndex % 3)
                    {
                        case 0:
                            charValue += (pixel.R % 2) * (int)Math.Pow(2, colorUnitIndex % 8);
                            break;
                        case 1:
                            charValue += (pixel.G % 2) * (int)Math.Pow(2, colorUnitIndex % 8);
                            break;
                        case 2:
                            charValue += (pixel.B % 2) * (int)Math.Pow(2, colorUnitIndex % 8);
                            break;
                    }

                    colorUnitIndex++;

                    if (colorUnitIndex % 8 == 0)
                    {
                        char c = (char)charValue;
                        if (c == '\0')
                            return extractedText;
                        extractedText += c;
                        charValue = 0;
                    }
                }
            }
        }
        return extractedText;
    }
}
